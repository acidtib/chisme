{
  "name": "chisme",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An Entire companion CLI: search your captured AI coding sessions locally, no entire.io account required.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "chisme": "bun run apps/cli/src/main.ts",
    "build:cli": "bun run apps/cli/build.ts",
    "install:cli": "bun run build:cli && bun run apps/cli/install.ts",
    "dev:server": "bun run --filter @chisme/server dev",
    "dev:web": "bun run --filter @chisme/web dev",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
